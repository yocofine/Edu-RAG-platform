APP_ENV=production

# ===== 容器镜像 =====
# 默认值可直接配合阿里云账号专属的 Docker Hub 镜像加速器使用。
# 若已将镜像同步到自己的 ACR，把下面各项替换为完整 ACR 地址；不要填写不存在的公共路径。
NODE_BASE_IMAGE=node:22-alpine
PYTHON_BASE_IMAGE=python:3.12-slim
NGINX_BASE_IMAGE=nginx:1.27-alpine
MYSQL_IMAGE=mysql:8.4
ETCD_IMAGE=quay.io/coreos/etcd:v3.5.18
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
MILVUS_IMAGE=milvusdb/milvus:v2.5.15
ATTU_IMAGE=zilliz/attu:v2.5.12

DATABASE_URL=mysql+pymysql://edu_rag:CHANGE_ME@mysql:3306/edu_rag?charset=utf8mb4
JWT_SECRET=CHANGE_TO_A_RANDOM_STRING_AT_LEAST_32_CHARACTERS
COOKIE_SECURE=true
CORS_ORIGINS=https://kb.example.com
STORAGE_BACKEND=minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=edu-rag-documents
MINIO_SECURE=false
DASHSCOPE_API_KEY=CHANGE_ME
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_INTENT_MODEL=qwen-plus
ACTIVE_SCENARIO_ID=education_kb
MINERU_URL=http://mineru:8000
MINERU_ENABLED=true
IMAGE_ANALYSIS_ENABLED=true
IMAGE_ANALYSIS_MODEL=qwen-vl-plus
IMAGE_ANALYSIS_MAX_IMAGES=60
IMAGE_ANALYSIS_CONCURRENCY=4
MINERU_API_MAX_CONCURRENT_REQUESTS=1
DINGTALK_ROBOT_WEBHOOK=
DINGTALK_ROBOT_SECRET=
DINGTALK_ROBOT_TIMEOUT_SECONDS=10
MAX_UPLOAD_MB=100
RECENT_UPLOAD_LIMIT=10
RETRIEVAL_VARIANTS_LLM_ENABLED=false
DOC_TOP_K=10
DOC_COMPLEX_QUERY_TOP_K=10
FINAL_CONTEXT_TOP_N=6
DOCUMENT_NEIGHBOR_WINDOW=1
DOCUMENT_FETCH_LIMIT=2000
PROCESS_CONTEXT_TOP_N=24
PROCESS_CONTEXT_MAX_CHARS=24000
SUMMARY_DOCUMENT_TOP_N=120
SUMMARY_DOCUMENT_MAX_CHARS=120000
SUMMARY_MAP_BATCH_CHARS=6000

PARENT_CHUNK_SIZE=1500
CHILD_CHUNK_SIZE=500
PARENT_OVERLAP=150
CHILD_OVERLAP=80
RECYCLE_DAYS=30
MYSQL_USER=edu_rag
MYSQL_PASSWORD=CHANGE_ME
MYSQL_DATABASE=edu_rag
MYSQL_ROOT_PASSWORD=CHANGE_ME
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
DOMAIN=kb.example.com
ACME_EMAIL=admin@example.com
WEB_BIND=127.0.0.1:8080
# 部署副本已包含 models/bge-m3；运行时只读挂载到 API 容器。
MODEL_HOST_PATH=./models
EMBEDDING_MODEL_PATH=/app/models/bge-m3
# 默认 API 重排模式不需要本地 reranker。切换为 local 时再取消下一行注释并上传模型。
# RERANKER_MODEL_PATH=/app/models/bge-reranker-large
SCENARIO_CONFIG_DIR=/app/scenarios

# ===== 二阶段重排后端 =====
# local = 容器内 CrossEncoder（无外部依赖，但纯 CPU 较慢，约 4s/次）
# api   = 调用远端 rerank 服务（约 1s/次，但需要出网 + 独立 Key，且候选原文会发往服务方）
RERANK_BACKEND=api
RERANK_API_MODEL=qwen3.7-text-rerank
RERANK_API_BASE_URL=https://dashscope.aliyuncs.com
# 重排走 DashScope，与主 LLM 可能不是同一家，所以是独立 Key
RERANK_API_KEY=CHANGE_ME
RERANK_API_TIMEOUT=30
RERANK_API_FALLBACK_LOCAL=false

# 单次回答注入的最大文档字符数
MAX_CONTEXT_DOC_CHARS=2600
